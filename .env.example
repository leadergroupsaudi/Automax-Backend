# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
# Comma-separated list of allowed CORS origins. Use * to allow all (credentials will be disabled).
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=automax
DB_PASSWORD=automax123
DB_NAME=automax
DB_SSLMODE=disable

# NATS (JetStream). The API still starts if this is unreachable.
NATS_URL=nats://localhost:4223

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=automax

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE_HOUR=0.00278         # ~10 seconds - access token expires fast
JWT_REFRESH_EXPIRE_HOUR=0.00833 # ~30 seconds - refresh token without remember-me
JWT_REMEMBER_EXPIRE_HOUR=0.03333 # ~2 minutes - refresh token WITH remember-me

# SSO Configuration
# PEM-encoded RSA-2048 private key for signing SSO tokens.
# Generate with: openssl genrsa -out sso_private.pem 2048
# Then copy the contents here, replacing newlines with \n
# If left empty, an ephemeral key is auto-generated on startup (dev only — not suitable for production).
SSO_RSA_PRIVATE_KEY=

# Public base URL of this Automax BACKEND instance (e.g. https://automax.example.com or http://localhost:8080).
# Embedded in the JWT "iss" claim so receiver deployments can automatically
# fetch the public key from {SSO_ISSUER_URL}/.well-known/jwks.json.
# Required for cross-deployment SSO. Leave empty for single-deployment / local dev.
SSO_ISSUER_URL=

# Public base URL of this Automax FRONTEND instance (e.g. https://automax.example.com or http://localhost:5173).
# Used by the /sso/callback handler to redirect the browser to /sso-complete after a successful SSO login.
# Required when the backend and frontend run on different ports (which is always the case in dev).
# If empty, the backend falls back to its own hostname — only works behind a reverse proxy where
# both backend and frontend share the same origin.
SSO_FRONTEND_URL=

# GEOLOCATION
MAX_INCIDENT_DISTANCE=500
CLIENT_CODE=EPM940
# PBX base URL for the extension-assignment feature (EPM940 only). Pool is read from
# PBX_BASE_URL + "?action=list"; a single extension from + "&username=<ext>".
PBX_BASE_URL=https://zkff.automaxsw.com/create_user.php
# Dev/staging only: skip PBX TLS verification. MUST stay false in production.
PBX_INSECURE_SKIP_VERIFY=false
# When true, assigning a department to a user auto-appends the department's
# locations and classifications to that user. Default: false.
SYNC_DEPT_ATTRIBUTES_TO_USER=false
# Comma-separated list of sources that bypass the 500m duplicate incident check (default: viusional)
SKIP_DUPLICATE_CHECK_SOURCES=viusional,mobile
# When true, super admins are also restricted by their assigned classification/location
# scoping in ListIncidents and GetStatsV2 (default: false, super admins see all data)
RESTRICT_ADMIN_SCOPE=false

# SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=as@gmail.com
SMTP_PASS=
SMTP_FROM=automaxtestdeveloper@gmail.com

# Twilio configuration
TWILIO_ACCOUNT_SID= 
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
 
# Meta Configuration
METAURL=https://graph.facebook.com/v24.0/asdf/messages
META_ACCESS_TOKEN=

OTP_TEMPLATE_URL=https://graph.facebook.com/v24.0/ax/messages
OTP_TEMPLATE_ACCESS_TOKEN=

# OTP Configuration
OTP_MAX_SEND_ATTEMPT=6
VERIFY_OTP_MAX_ATTEMPT=3
OTP_DATA_REDIS_EXPIRATION_TIME=2
OTP_COUNTER_EXPIRATION_TIME=2

# LDAP/Active Directory Configuration
# # ==============================
# # LDAP / Active Directory Config
# # ==============================
LDAP_ENABLED=true
# Domain Controller (AD Server)
LDAP_URL=ldap://xxx.xxx.xxx.xxx:xxx
# Base DN
LDAP_BASE_DN=DC=test,DC=amx,DC=local
# Bind credentials (UPN format)
LDAP_BIND_DN=example@test.amx.local
LDAP_BIND_PASSWORD=Testamxexample
# User login search
LDAP_USER_SEARCH_BASE=DC=test,DC=amx,DC=local
LDAP_USER_SEARCH_FILTER=(sAMAccountName={{username}})
# Group search (optional)
LDAP_GROUP_SEARCH_BASE=
LDAP_GROUP_SEARCH_FILTER=
# SSL verification (disable for internal AD)
LDAP_INSECURE_SKIP_VERIFY=true

# Login Rate Limiting Configuration
LOGIN_RATE_LIMIT_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW=5
BLOCK_DURATION=15

# Escalation Configuration 
ESCALATION_DAILY_HOUR=15
ESCALATION_DAILY_MINUTE=10
ESCALATION_WEEKLY_HOUR=09
ESCALATION_WEEKLY_MINUTE=00


FRONTEND_URL=http://localhost:5173

# notify when < 24 hour left
 READY_TO_CLOSE_PRE_EXPIRY_HOURS=24

# fcm json for E940
 FIREBASE_CREDENTIAL_PATH=ax.json


# AI Quality Monitor
AI_QUALITY_API_ENDPOINT=https://unicam.discretal.com/incident-resolution-verifier/verify-incident
AI_QUALITY_API_KEY=
AI_QUALITY_CHECK_INTERVAL_MINUTES=10

NAFATH_API_BASE_URL=http://localhost:5174

# Final-close WhatsApp feedback session cleanup: when SMS feedback is submitted
FINAL_CLOSE_WHATSAPP_FEEDBACK_SESSION_BASE_URL=https://unicam.discretal.com/automax3-feedback/session

# this is for auto distributed incident assign logic
DISTRIBUTE_INCIDENT_ASSIGN=false



# License Configuration
# APP_ENV controls dev-only behavior such as the dev license seeder. Set to "production" in prod.
APP_ENV=development
# LICENSE_ENABLED globally toggles license-gate middleware. Keep true in prod.
LICENSE_ENABLED=true
# LICENSE_ENCRYPTION_KEY is a 32-byte hex string used to encrypt the stored license JWT at rest (AES-256-GCM).
# REQUIRED — generate with: openssl rand -hex 32
LICENSE_ENCRYPTION_KEY=
# Grace period (days) after expiry during which features still work with a warning.
LICENSE_GRACE_PERIOD_DAYS=7
# Dev-only: auto-seed a full-scope license at startup. Ignored when APP_ENV=production unless LICENSE_DEV_SEED=true.
LICENSE_DEV_SEED=false
LICENSE_DEV_EXPIRY_DAYS=90

MAX_INCIDENT_DISTANCE=100

KPI_DOCUMENTA_BASE_URL=
KPI_DOCUMENTA_CLIENT_ID=
KPI_DOCUMENTA_CLIENT_SECRET=
KPI_DOCUMENTA_WORKSPACE_NAME=
KPI_DOCUMENTA_ENABLED=

# Workflow.Code the KPI Workflow (Draft->Reviewed->Approved->Active->Closed)
# is looked up by. Must match the Code the seed creates it with — changing
# this after the workflow has already been seeded just makes it unfindable
# until re-seeded under the new code. Default: kpi_dictionary_workflow
KPI_DICTIONARY_WORKFLOW_CODE=kpi_dictionary_workflow

NASAQ_SERVICE_BASE_URL=http://localhost:8092



